{
  "name": "naiwa-monopoly",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "test:browser:3d": "node tools/qa-browser-3d.mjs",
    "benchmark": "node tools/benchmark.mjs",
    "test:performance": "playwright test --config=playwright.performance.config.mjs",
    "test:a11y": "playwright test --config=playwright.mobile.config.mjs e2e/a11y.spec.mjs",
    "test:mobile": "playwright test --config=playwright.mobile.config.mjs",
    "dev": "python -m http.server 4173 --directory dist",
    "build": "node tools/build.mjs",
    "build:site": "node tools/build-web.mjs",
    "preview": "python -m http.server 4173 --directory out"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "esbuild": "0.25.0"
  }
}
