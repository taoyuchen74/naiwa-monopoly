{
  "name": "naiwa-monopoly",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "python -m http.server 4173 --directory dist",
    "build": "node tools/build.mjs",
    "build:site": "node tools/build-web.mjs",
    "preview": "python -m http.server 4173 --directory out",
    "typecheck": "tsc --noEmit --allowJs --checkJs",
    "lint": "node tools/check-changed.mjs",
    "lint:all": "eslint . --max-warnings=0",
    "format:check": "node tools/check-changed.mjs --format-only",
    "test:coverage": "c8 npm test",
    "test:e2e": "playwright test",
    "test:slow": "node tools/simulate-100.mjs",
    "check:size": "node tools/check-size.mjs",
    "serve:ci": "node tools/serve.mjs out 4173"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "20.19.24",
    "c8": "10.1.3",
    "esbuild": "0.25.0",
    "eslint": "10.13.0",
    "pngjs": "7.0.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
