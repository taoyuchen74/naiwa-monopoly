{
  "name": "naiwa-monopoly",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc -p jsconfig.json",
    "lint": "node tools/check-changed.mjs",
    "lint:all": "eslint . --max-warnings=0",
    "format:check": "node tools/check-changed.mjs --format-only",
    "test:coverage": "c8 npm test",
    "test:e2e": "playwright test --config=playwright.engineering.config.mjs",
    "test:slow": "node tools/simulate-100.mjs",
    "check:size": "node tools/check-size.mjs",
    "serve:ci": "node tools/serve.mjs out 4173",
    "test:browser": "playwright test",
    "start:cloud": "npm run build:site && node server/start-cloud.mjs",
    "test:cloud": "playwright test --config=playwright.cloud.config.mjs",
    "start:online": "npm run build:site && node server/start.mjs",
    "test:online": "playwright test --config=playwright.online.config.mjs",
    "test:browser:3d": "node tools/qa-browser-3d.mjs",
    "benchmark": "node tools/benchmark.mjs",
    "test:performance": "playwright test --config=playwright.performance.config.mjs",
    "test:a11y": "playwright test --config=playwright.mobile.config.mjs e2e/a11y.spec.mjs",
    "test:mobile": "playwright test --config=playwright.mobile.config.mjs",
    "dev": "python -m http.server 4173 --directory dist",
    "build": "node tools/build.mjs",
    "build:site": "node tools/build-web.mjs",
    "preview": "python -m http.server 4173 --directory out"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "esbuild": "0.25.0",
    "typescript": "7.0.2",
    "c8": "10.1.3",
    "eslint": "10.13.0",
    "pngjs": "7.0.0",
    "prettier": "3.6.2"
  },
  "dependencies": {
    "ws": "8.22.0"
  }
}
